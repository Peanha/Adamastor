root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{c,cc,h}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 100

[{Makefile,makefile}]
indent_style = tab
tab_width = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

